:root {
}

.background {
    border-top-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    border-left-color: rgba(255, 255, 255, 0.196);
    border-right-color: rgba(255, 255, 255, 0.196);
    border-top-color: rgba(255, 255, 255, 0.196);
    border-bottom-color: rgba(255, 255, 255, 0.196);
    background-color: rgba(0, 0, 0, 0.69);
    padding-left: 8px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
}

.character_text {
    border-left-color: rgba(0, 0, 0, 0.196);
    border-right-color: rgba(0, 0, 0, 0.196);
    border-top-color: rgba(0, 0, 0, 0.196);
    border-bottom-color: rgba(0, 0, 0, 0.196);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    background-color: rgba(255, 255, 255, 0.588);
    height: 128px;
    white-space: normal;
    margin-bottom: 8px;
    font-size: 24px;
    -unity-font-style: bold;
}

.character_button {
    height: 200px;
    left: 0;
    right: 0;
}
